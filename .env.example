NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llama_auth
LLAMA_AUTH_JWT_SECRET=replace-with-a-64-plus-character-random-secret
LLAMA_AUTH_ACCESS_TTL=15m
LLAMA_AUTH_REFRESH_DAYS=30
LLAMA_AUTH_COOKIE_NAME=llama_refresh
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false